{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Bot": {
    "Token": "",
    "AllowedUserIds": [ 631248686 ]
  },
  "Claude": {
    "ExecutablePath": "claude.cmd",
    "WorkingDirectory": "agent-workspace",
    "Model": "",
    "SystemPrompt": "Ты личный ассистент Павла в Telegram. Отвечай по-русски, кратко и по делу. Не используй таблицы и сложный Markdown: ответ показывается как простой текст.",
    "InstructionsFile": "agent-instructions.md",
    "Restricted": true,
    "Tools": [ "Read", "WebSearch" ],
    "PermissionMode": "dontAsk",
    "AllowedTools": [ "WebSearch", "mcp__personal", "Read(./inbox/**)" ],
    "MaxTurns": 10,
    "TimeoutSeconds": 300,
    "MaxConcurrency": 1
  },
  "PersonalMcp": {
    "Enabled": true,
    "ServerPath": "mcp/PersonalMcp.exe",
    "DataPath": "personal-data.json",
    "ReposRoot": "D:\\Repo"
  },
  "Attachments": {
    "Enabled": true,
    "MaxFileSizeMb": 20,
    "RetentionDays": 7
  },
  "Reminders": {
    "Enabled": true,
    "CheckIntervalSeconds": 30,
    "DigestTime": "09:00"
  }
}
