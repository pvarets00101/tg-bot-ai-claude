<Project Sdk="Microsoft.NET.Sdk">

  <!-- Реализации репозиториев из ClaudeTelegramBot.Domain: JSON-файлы, SQLite и PostgreSQL.
       Какая используется, решает конфиг (Storage:Provider). Здесь же фабрика, регистрация в DI
       и перенос данных между хранилищами. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
    <PackageReference Include="Npgsql" Version="10.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeTelegramBot.Domain\ClaudeTelegramBot.Domain.csproj" />
  </ItemGroup>

</Project>
