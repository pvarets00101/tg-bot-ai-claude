<Project Sdk="Microsoft.NET.Sdk">

  <!-- MCP-сервер с личными инструментами агента. Claude Code запускает его сам (stdio)
       при каждом вызове `claude -p`. net10.0, как у бота: бот передаёт серверу DOTNET_ROOT своего рантайма (ClaudeRunner).
       Отдельно запускать его не нужно — без клиента MCP он просто ждёт ввод в stdin.
       Инструменты работают с интерфейсами из ClaudeTelegramBot.Domain; Storage нужен только для регистрации в DI. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.*" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeTelegramBot.Storage\ClaudeTelegramBot.Storage.csproj" />
  </ItemGroup>

</Project>
