<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>claude-telegram-bot</UserSecretsId>
    <!-- PersonalMcp — отдельный проект во вложенной папке, его файлы не должны попадать в бота. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);PersonalMcp\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.*" />
    <PackageReference Include="Telegram.Bot" Version="22.*" />
  </ItemGroup>

  <!-- Хранилище заметок и задач общее с MCP-сервером: бот читает его для напоминаний. -->
  <ItemGroup>
    <Compile Include="PersonalMcp\DataStore.cs" Link="Shared\DataStore.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="agent-instructions.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="agent-workspace\.gitkeep" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Собираем MCP-сервер вместе с ботом (без ссылки на сборку) и кладём его в bin\...\mcp. -->
  <ItemGroup>
    <ProjectReference Include="PersonalMcp\PersonalMcp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyPersonalMcp" AfterTargets="Build">
    <ItemGroup>
      <PersonalMcpFiles Include="PersonalMcp\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PersonalMcpFiles)"
          DestinationFiles="@(PersonalMcpFiles->'$(OutDir)mcp\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
